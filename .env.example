# ==========================================
# Nova Studio — Environment Configuration
# ==========================================

# Node Environment
NODE_ENV=production

# Server Ports
PORT=3002
FRONTEND_PORT=3001

# URLs
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002

# Database Storage Directory (defaults to data/ in monorepo root)
DATA_DIR=../../data
BACKUP_DIR=../../backups

# Default Admin Credentials (Change in Production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# JWT & Cookie Secret
SESSION_SECRET=nova_studio_secure_jwt_session_secret_change_in_prod_key_778899


# ==========================================
# Nova Studio — Environment Configuration
# ==========================================

APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=UTC
APP_URL=http://panel.example.com
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# Local Ports & URLs
# ==========================================
PORT_WEB=3001
PORT_API=3002
FRONTEND_PORT=3001
PORT=3002

FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002
INTERNAL_API_URL=http://127.0.0.1:3002

# ==========================================
# Default Admin Credentials (Change in Production!)
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@novastudio.internal

# ==========================================
# Discord Setup
# ==========================================
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_BOT_TOKEN=

# ==========================================
# YouTube Setup
# ==========================================
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# ==========================================
# GitHub Setup
# ==========================================
GITHUB_USERNAME=
GITHUB_PERSONAL_ACCESS_TOKEN=

# ==========================================
# Database Setup (SQLite, MariaDB, Supabase)
# ==========================================
DATA_DIR=/workspaces/w/d/data
BACKUP_DIR=/workspaces/w/d/backups

# MariaDB / MySQL Configuration
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=novastudio
DB_USERNAME=root
DB_PASSWORD=

# Supabase Credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# Cache, Queue & Session
# ==========================================
CACHE_DRIVER=file
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

SESSION_SECRET=nova_studio_secure_jwt_session_secret_change_in_prod_key_778899
HASHIDS_SALT=
HASHIDS_LENGTH=8

# ==========================================
# Mail Configuration (SMTP)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Nova Panel"
